#!/usr/bin/env bash
# agy-pilot wrapper — compatible con symlinks en ~/bin/

# Resolver symlinks para encontrar la ruta real del script
TARGET="${BASH_SOURCE[0]}"
while [ -L "$TARGET" ]; do
    DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"
    TARGET="$(readlink "$TARGET")"
    [[ $TARGET != /* ]] && TARGET="$DIR/$TARGET"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET")" >/dev/null 2>&1 && pwd)"

exec python3 "$SCRIPT_DIR/agy_pilot.py" "$@"
